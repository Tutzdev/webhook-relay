# Copy to .env and change the values before running docker compose.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# The demo receiver lives on the same app, so the demo needs private URLs. Keep both false in production.
RELAY_DEMO_RECEIVER=true
RELAY_ALLOW_PRIVATE_URLS=true
